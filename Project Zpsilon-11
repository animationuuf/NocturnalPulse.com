<!doctype html>
<html lang="ru">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Smart OS — Desktop Environment</title>
<style>
:root{--aqua:#a0e9ed;--aqua2:#55c7cf;--panel:rgba(7,17,18,.82);--panel2:rgba(11,25,26,.93);--line:rgba(170,231,229,.18);--muted:#9ab4b4;--white:#e8f5f3;--barH:38px}
*{box-sizing:border-box}
html,body{width:100%;height:100%;margin:0;overflow:hidden;background:#061213;color:var(--white);font:13px/1.45 "Segoe UI",Inter,Arial,sans-serif}
button,input,select,textarea{font:inherit}
button{color:inherit;cursor:pointer}
#wallpaper{position:fixed;inset:0;z-index:0;background:#071719 center/cover no-repeat;transition:background-image .35s,filter .35s}
#wallpaper:after{content:"";position:absolute;inset:0;background:linear-gradient(180deg,rgba(1,11,14,.16),rgba(1,9,11,.22) 52%,rgba(0,8,9,.44))}
#fx{position:fixed;inset:0;width:100%;height:100%;z-index:1;pointer-events:none;opacity:.55}
#desktop{position:fixed;inset:var(--barH) 0 0;z-index:2;pointer-events:none}
#topbar{height:var(--barH);position:fixed;z-index:1000;top:0;left:0;right:0;display:flex;align-items:center;gap:6px;padding:4px 6px;background:rgba(3,12,14,.74);backdrop-filter:blur(18px);border-bottom:1px solid rgba(164,221,218,.13);box-shadow:0 4px 18px #0002;font-size:11px}
.bar-group{height:29px;display:flex;align-items:center;gap:4px;padding:0 3px;border-radius:8px;background:rgba(5,17,19,.38);border:1px solid rgba(255,255,255,.045)}
.iconbtn{height:25px;min-width:26px;padding:0 7px;border:0;border-radius:6px;background:transparent;color:#d5e9e7;font-size:14px}
.iconbtn:hover,.iconbtn.active{background:rgba(149,222,224,.18);color:#b6fbff}
.workspace{width:18px;height:21px;padding:0;border:0;border-radius:5px;background:rgba(255,255,255,.075);color:#b8cfce;font:600 10px "Segoe UI";transition:.15s}
.workspace.active{background:var(--aqua);color:#163238;box-shadow:0 0 12px #8de7eb55}
.workspace:hover{background:rgba(153,229,231,.35);color:#fff}
#workspaces{gap:3px;padding:0 5px}
#trackbar{min-width:150px;max-width:245px;flex:0 1 245px;gap:6px;padding:0 7px}
.mini-cover{width:17px;height:17px;border-radius:4px;background:linear-gradient(140deg,#9ce7e8,#263e58 55%,#d5b4b4);flex:none}
.track-info{min-width:0;flex:1;line-height:1.15}
.track-info b{display:block;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;font-size:10px;font-weight:600}
.track-info small{font-size:8px;color:#8ea9a9}
.track-controls{display:flex;align-items:center;gap:1px}
.track-controls button{font-size:11px;min-width:18px;height:20px;padding:0}
#timeWeather{min-width:150px;justify-content:center;gap:10px;padding:0 8px;margin:0 auto}
.clock-main{font:600 11px Consolas,monospace;color:#b7f0ef;letter-spacing:.4px}
.clock-sub{font-size:8px;color:#91aaa9;margin-top:-2px}
.weather-mini{font-size:11px;color:#d9eeee;white-space:nowrap}
#tray{margin-left:auto;gap:4px;padding:0 5px;white-space:nowrap}
.tray-pill{height:22px;padding:0 8px;display:flex;align-items:center;gap:5px;border-radius:6px;background:rgba(255,255,255,.12);border:1px solid rgba(255,255,255,.05);color:#e4f2f1;font-size:10px}
.tray-pill:hover{background:rgba(166,230,231,.25)}
.level{display:inline-block;width:25px;height:5px;border-radius:10px;background:#375456;overflow:hidden}
.level i{display:block;height:100%;width:68%;background:var(--aqua)}
#power{color:#f1b5a9}
.panel{position:fixed;z-index:300;display:none;color:#e3f0ee;background:var(--panel);border:1px solid rgba(164,229,226,.16);border-radius:13px;box-shadow:0 22px 70px #0008,0 0 28px #5bcbd012;backdrop-filter:blur(26px);overflow:hidden}
.panel.show{display:block;animation:appear .18s ease-out}
@keyframes appear{from{opacity:0;transform:translateY(7px) scale(.99)}to{opacity:1;transform:none}}
.panel-head{display:flex;align-items:center;gap:10px;padding:14px 16px;border-bottom:1px solid var(--line);font-weight:600}
.panel-head .sub{color:var(--muted);font-weight:400;font-size:10px;margin-left:auto}
.close{border:0;background:transparent;color:#a9c3c1;font-size:18px;line-height:1;padding:0 4px}
.close:hover{color:white}
.panel-body{padding:14px;max-height:calc(100% - 50px);overflow:auto}
#settings{left:8px;top:44px;bottom:8px;width:292px;border-radius:10px}
#settings .panel-body{height:calc(100% - 50px);padding:9px;overflow:auto}
.tabs{display:flex;gap:5px;margin-bottom:10px}
.tab{flex:1;border:1px solid transparent;border-radius:6px;background:rgba(255,255,255,.035);padding:7px 4px;font-size:10px;color:#a8c0bf}
.tab.active{background:rgba(130,211,212,.15);border-color:#7bc9cc33;color:#c8f3f2}
.setting-card{padding:11px 10px;border:1px solid rgba(255,255,255,.055);border-radius:8px;background:rgba(255,255,255,.035);margin-bottom:8px}
.setting-title{font-size:11px;font-weight:600;display:flex;align-items:center;gap:8px}
.setting-desc{font-size:9px;color:#829f9e;margin:3px 0 0 23px}
.setting-line{display:flex;align-items:center;justify-content:space-between;gap:8px}
.setting-card input[type=text],.field,.setting-card select{width:100%;margin-top:8px;background:#101e20;border:1px solid #365051;border-radius:6px;padding:8px;color:#dcedeb;outline:none}
input[type=range]{accent-color:var(--aqua2);width:100%}
.switch{appearance:none;width:34px;height:18px;border-radius:20px;background:#344b4c;position:relative;cursor:pointer;flex:none;outline:none}
.switch:before{content:"";position:absolute;left:3px;top:3px;width:12px;height:12px;border-radius:50%;background:#d3e4e1;transition:.18s}
.switch:checked{background:#5ebdc1}
.switch:checked:before{left:19px;background:#092729}
.apply{width:100%;border:1px solid #96e5e5;background:var(--aqua);color:#123235;padding:9px;border-radius:7px;font-weight:700;margin-top:4px}
.apply:hover{filter:brightness(1.08)}
.keyrow{display:flex;justify-content:space-between;gap:8px;padding:9px 6px;border-bottom:1px solid #ffffff0d;font-size:10px}
kbd{background:#263839;border:1px solid #456061;border-radius:4px;padding:3px 6px;color:#d7eeee;font:10px Consolas}
#quickPanel{right:8px;top:44px;width:280px}
.quick-grid{display:grid;grid-template-columns:1fr 1fr;gap:8px}
.quick-tile{padding:13px 11px;border-radius:9px;background:rgba(255,255,255,.055);border:1px solid #ffffff12;text-align:left}
.quick-tile.on{background:rgba(59,172,177,.22);border-color:#75dadd55}
.quick-tile b{display:block;font-size:12px;margin-top:6px}
.quick-tile small{font-size:9px;color:#9cb5b3}
.net-orbit{position:relative;height:180px;margin:7px auto 14px;max-width:230px}
.orbit-ring{position:absolute;inset:10px 27px;border:1px solid #73d9d355;border-radius:50%;transform:rotate(-22deg)}
.net-core{position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);width:102px;height:102px;border-radius:50%;display:grid;place-content:center;text-align:center;background:radial-gradient(circle,#1c8e90,#0f484b 70%);box-shadow:0 0 40px #24a9a866;border:1px solid #83f0ec66}
.net-core strong{font-size:11px}.net-core small{font-size:9px;color:#b5dfdd}
.net-node{position:absolute;padding:7px 9px;background:#142527;border:1px solid #456061;border-radius:7px;font-size:9px;color:#cde3e1}
.net-node strong{display:block;font-size:10px;color:#efffff}
#calendar{width:min(820px,calc(100vw - 24px));top:50%;left:50%;transform:translate(-50%,-50%);border-radius:14px}
#calendar.show{animation:appearCenter .2s ease-out}
@keyframes appearCenter{from{opacity:0;transform:translate(-50%,-48%) scale(.98)}to{opacity:1;transform:translate(-50%,-50%) scale(1)}}
.calendar-layout{display:grid;grid-template-columns:1.15fr 1fr;gap:14px}
.cal-left,.cal-right,.weather-card{background:rgba(255,255,255,.035);border:1px solid #ffffff0c;border-radius:10px;padding:14px}
.cal-top{display:flex;justify-content:space-between;align-items:center;margin-bottom:12px}
.cal-grid{display:grid;grid-template-columns:repeat(7,1fr);gap:5px;text-align:center;font-size:10px}
.cal-grid span{padding:7px 0;border-radius:5px;color:#a9c5c4}
.cal-grid span.today{background:var(--aqua);color:#173739;font-weight:700}
.cal-grid span.dim{opacity:.3}
.big-time{font:600 clamp(30px,5vw,52px) Consolas,monospace;text-align:center;letter-spacing:2px;margin:8px 0;color:#eefafa}
.big-date{text-align:center;color:#a8bfbe;font-size:11px}
.weather-current{display:flex;justify-content:space-between;align-items:center}
.weather-temp{font-size:52px;font-weight:300}
.weather-desc{font-size:11px;color:#9cb9b7}
.forecast{display:flex;justify-content:space-between;gap:7px;margin-top:18px}
.forecast div{flex:1;text-align:center;padding:9px 2px;border-radius:7px;background:#ffffff08;font-size:9px}
.forecast strong{display:block;margin:5px 0;font-size:12px}
.metrics{display:flex;gap:7px;margin-top:12px}
.metric{flex:1;padding:9px;background:#ffffff08;border-radius:8px;text-align:center;font-size:9px;color:#9db8b6}
.metric b{display:block;color:#e5f9f7;font-size:14px}
#wallpicker{left:0;right:0;top:50%;transform:translateY(-50%);border-radius:0;background:rgba(4,14,15,.68);border-left:0;border-right:0}
#wallpicker.show{animation:none}
.wall-tools{display:flex;justify-content:center;align-items:center;gap:9px;padding:13px}
.color-dot{width:18px;height:18px;border-radius:5px;border:1px solid #ffffff4d;cursor:pointer}
.wall-track{display:flex;gap:12px;overflow-x:auto;padding:12px 22px 20px;scrollbar-width:thin}
.wall-card{position:relative;flex:0 0 230px;height:150px;border-radius:8px;overflow:hidden;border:1px solid #ffffff28;cursor:pointer;transform:skewX(-7deg);transition:.2s;background-size:cover;background-position:center}
.wall-card:hover{transform:skewX(-7deg) translateY(-5px);border-color:var(--aqua)}
.wall-card.active{outline:2px solid var(--aqua);outline-offset:2px}
.wall-card span{position:absolute;bottom:0;left:0;right:0;padding:23px 12px 8px;background:linear-gradient(transparent,#000c);font-size:10px;transform:skewX(7deg)}
#launcher{left:50%;top:50%;width:min(560px,94vw);transform:translate(-50%,-50%);padding:16px}
#launcher.show{animation:appearCenter .2s}
.searchbox{width:100%;border-radius:8px;background:#102021;color:white;border:1px solid #426566;padding:12px 14px;outline:none}
.app-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:8px;margin-top:14px}
.appitem{border:1px solid transparent;border-radius:9px;background:rgba(255,255,255,.035);padding:12px 5px;text-align:center;font-size:10px}
.appitem:hover{background:#a0e9ed22;border-color:#8be0e144}
.appitem i{font-style:normal;display:block;font-size:24px;margin-bottom:5px}
#displayDialog{top:50%;left:50%;transform:translate(-50%,-50%);width:min(510px,94vw)}
.display-layout{display:grid;grid-template-columns:1fr 1.2fr;gap:15px;align-items:center}
.monitor-demo{height:150px;border:8px solid #283d3f;border-bottom-width:15px;border-radius:8px;background:linear-gradient(140deg,#182c2f,#0e1719);display:grid;place-content:center;text-align:center;color:#9ec9c8}
.res-options{display:grid;grid-template-columns:1fr 1fr;gap:6px}
.res-option{padding:9px;text-align:left;border:1px solid #ffffff13;border-radius:6px;background:#ffffff06;font-size:10px}
.res-option.active{border-color:var(--aqua);background:#8ee4e522}
#notify{right:8px;top:44px;width:260px}
#monitor{inset:48px 12px 12px;width:auto;height:auto}
.monitor-grid{height:100%;display:grid;grid-template-columns:1fr 1.2fr;grid-template-rows:1fr 1fr;gap:7px}
.monitor-cell{background:#020a0aeb;border:1px solid #88d8d233;border-radius:6px;padding:12px;position:relative;overflow:hidden}
.monitor-cell h3{font:11px Consolas,monospace;color:#9fe8df;margin:0 0 8px}
.ascii{font:12px/1.3 Consolas,monospace;color:#9ee3d7;white-space:pre;overflow:hidden}
.bars{height:calc(100% - 24px);display:flex;align-items:end;gap:4px;padding-top:10px}
.bars i{flex:1;min-width:3px;background:linear-gradient(180deg,#edc0c0,#b5f5d5 60%);border-radius:2px 2px 0 0;animation:barwave .8s ease-in-out infinite alternate}
.bars i:nth-child(3n){animation-delay:-.4s}.bars i:nth-child(4n){animation-delay:-.65s}
@keyframes barwave{from{height:15%}to{height:85%}}
#appWin
